<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:theme="@style/ThemeOverlay.LuckyShake.Home">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/result_sky" />
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ScrollView android:id="@+id/result_root" android:layout_width="0dp" android:layout_height="match_parent" android:fillViewport="true" app:layout_constraintWidth_max="600dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="32dp" android:paddingTop="20dp" android:paddingEnd="32dp" android:paddingBottom="20dp">
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="4" />
                <TextView android:id="@+id/result_title_fortune" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/result_title_background" android:elevation="4dp" android:fontFamily="sans-serif" android:gravity="center" android:paddingHorizontal="20dp" android:paddingVertical="8dp" android:text="@string/result_title_fortune" android:textColor="@color/home_thumb" android:textSize="25sp" android:textStyle="bold" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="252dp" android:clipChildren="false">
                    <com.cs364.luckyshake.ui.home.ShadowImageView android:id="@+id/result_image_stick" android:layout_width="33dp" android:layout_height="224dp" android:layout_gravity="center" android:importantForAccessibility="no" app:srcCompat="@drawable/home_stick" />
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/home_filter_card" android:elevation="5dp" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="11dp">
                    <TextView android:id="@+id/result_label_stick" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_accent" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/result_label_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_ink" android:textSize="21sp" android:layout_marginTop="4dp" android:textStyle="bold" android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/result_label_type_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_ink" android:textSize="14sp" android:layout_marginTop="5dp" />
                    <TextView android:id="@+id/result_label_stars" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_accent" android:textSize="17sp" android:layout_marginTop="8dp" android:textStyle="bold" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/home_outline" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/result_label_fortune" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_ink" android:textSize="15sp" android:layout_marginTop="8dp" />
                    <TextView android:id="@+id/result_msg_disclaimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_ink" android:textSize="12sp" android:layout_marginTop="8dp" android:text="@string/result_msg_disclaimer" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/home_filter_card" android:elevation="5dp" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp">
                    <TextView android:id="@+id/result_label_quota" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_ink" android:textSize="13sp" android:layout_marginTop="3dp" />
                    <TextView android:id="@+id/result_label_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_ink" android:textSize="14sp" android:layout_marginTop="3dp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/result_action_row">
                        <com.google.android.material.button.MaterialButton android:id="@+id/result_btn_accept" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/result_btn_accept" android:textColor="@color/home_thumb" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/home_draw_tint" app:cornerRadius="26dp" app:strokeColor="@color/home_outline" app:strokeWidth="1dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/result_btn_redraw" android:layout_marginStart="6dp" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/result_btn_redraw" android:textColor="@color/result_secondary_text" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/home_paper" app:cornerRadius="26dp" app:strokeColor="@color/home_outline" app:strokeWidth="1dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/result_btn_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/result_btn_home" android:textColor="@color/home_thumb" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" app:backgroundTint="@color/home_draw_tint" app:cornerRadius="26dp" app:strokeColor="@color/home_outline" app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>