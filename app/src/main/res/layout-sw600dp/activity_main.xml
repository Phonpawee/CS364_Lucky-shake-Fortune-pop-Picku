<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:theme="@style/ThemeOverlay.LuckyShake.Home" android:clipToPadding="false">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/home_sky" />
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:fillViewport="true" app:layout_constraintWidth_max="600dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="32dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
                <androidx.constraintlayout.widget.ConstraintLayout style="@style/Widget.LuckyShake.TabBanner" android:background="@null" android:layout_marginBottom="6dp">
                    <TextView android:id="@+id/home_title_main" style="@style/Widget.LuckyShake.TabBanner.Title" android:layout_width="wrap_content" android:text="@string/home_title_main" android:textSize="32sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constrainedWidth="true" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:gravity="center" android:text="@string/home_shake_hint" android:textColor="@color/home_title" android:textSize="15sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/home_filter_card" android:elevation="5dp" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/home_picker_row">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="10dp" android:orientation="vertical">
                            <TextView android:id="@+id/home_label_set" android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/home_spinner_set" android:text="@string/home_label_set" android:textStyle="bold" />
                            <Spinner android:id="@+id/home_spinner_set" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:paddingStart="10dp" android:paddingEnd="30dp" android:background="@drawable/home_spinner_background" android:popupBackground="@color/home_field" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/home_label_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/home_spinner_type" android:text="@string/home_label_filter_type" android:textStyle="bold" />
                            <Spinner android:id="@+id/home_spinner_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:paddingStart="10dp" android:paddingEnd="30dp" android:background="@drawable/home_spinner_background" android:popupBackground="@color/home_field" />
                        </LinearLayout>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/home_switch_no_fried" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_label_no_fried" app:thumbTint="@color/home_thumb" app:trackTint="@color/home_switch_track" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/home_switch_no_spicy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_label_no_spicy" app:thumbTint="@color/home_thumb" app:trackTint="@color/home_switch_track" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/home_outline" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/home_filter_footer">
                        <TextView android:id="@+id/home_label_filter_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:accessibilityLiveRegion="polite" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/home_btn_clear_filters" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_btn_clear_filters" android:textColor="@color/home_accent" />
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="340dp" android:layout_marginTop="28dp" android:clipChildren="false" android:clipToPadding="false">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="51dp" android:layout_height="51dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="12dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_sakura" />
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="end|top" android:layout_marginEnd="20dp" android:layout_marginTop="36dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_maple" />
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="54dp" android:layout_height="54dp" android:layout_gravity="center_horizontal|top" android:translationX="78dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_star" />
                    <com.cs364.luckyshake.ui.home.ShadowImageView android:layout_width="196dp" android:layout_height="218dp" android:layout_gravity="center_horizontal|bottom" android:translationX="100dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_fox" />
                    <com.cs364.luckyshake.ui.home.ShadowImageView android:id="@+id/home_image_tube" android:layout_width="174dp" android:layout_height="299dp" android:layout_gravity="center_horizontal|bottom" android:layout_marginEnd="61dp" android:contentDescription="@string/home_label_tube" android:scaleType="fitCenter" app:srcCompat="@drawable/home_tube" />
                    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/home_image_stick" android:layout_width="16dp" android:layout_height="133dp" android:layout_gravity="center_horizontal|top" android:layout_marginTop="104dp" android:layout_marginEnd="61dp" android:importantForAccessibility="no" android:visibility="invisible" android:scaleType="fitCenter" app:srcCompat="@drawable/home_stick" />
                </FrameLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/home_btn_draw" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:minHeight="58dp" android:fontFamily="serif" android:text="@string/home_btn_draw" android:textColor="@color/home_thumb" android:textSize="23sp" android:textStyle="bold" app:backgroundTint="@color/home_draw_tint" app:cornerRadius="30dp" app:strokeColor="@color/home_outline" app:strokeWidth="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reminder_permission_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:text="@string/reminder_btn_allow_notifications" android:textColor="@color/home_ink" app:backgroundTint="@color/home_paper" app:cornerRadius="24dp" app:strokeColor="@color/home_outline" app:strokeWidth="1dp" />
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>