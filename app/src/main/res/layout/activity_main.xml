<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LuckyShake.Home"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/home_sky" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Widget.LuckyShake.TabBanner"
                android:background="@null"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/home_title_main"
                    style="@style/Widget.LuckyShake.TabBanner.Title"
                    android:layout_width="wrap_content"
                    android:text="@string/home_title_main"
                    android:textSize="32sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_filter_card"
                android:elevation="9dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/home_label_set"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/home_spinner_set"
                            android:text="@string/home_label_set"
                            android:textStyle="bold" />
                        <Spinner
                            android:id="@+id/home_spinner_set"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="30dp"
                            android:background="@drawable/home_spinner_background"
                            android:popupBackground="@color/home_field" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/home_label_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/home_spinner_type"
                            android:text="@string/home_label_filter_type"
                            android:textStyle="bold" />
                        <Spinner
                            android:id="@+id/home_spinner_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="30dp"
                            android:background="@drawable/home_spinner_background"
                            android:popupBackground="@color/home_field" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/home_switch_no_fried"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/home_label_no_fried"
                    app:thumbTint="@color/home_thumb"
                    app:trackTint="@color/home_switch_track" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/home_switch_no_spicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/home_label_no_spicy"
                    app:thumbTint="@color/home_thumb"
                    app:trackTint="@color/home_switch_track" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/home_outline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_label_filter_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_btn_clear_filters"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/home_btn_clear_filters"
                        android:textColor="@color/home_accent" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="224dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/home_sakura" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|top"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="25dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/home_maple" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    android:layout_gravity="center_horizontal|top"
                    android:translationX="54dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/home_star" />
                <com.cs364.luckyshake.ui.home.ShadowImageView
                    android:layout_width="135dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:translationX="69dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/home_fox" />
                <com.cs364.luckyshake.ui.home.ShadowImageView
                    android:id="@+id/home_image_tube"
                    android:layout_width="120dp"
                    android:layout_height="206dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginEnd="42dp"
                    android:contentDescription="@string/home_label_tube"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/home_tube" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/home_image_stick"
                    android:layout_width="11dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="72dp"
                    android:layout_marginEnd="42dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/home_stick" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/result_title_background"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="@string/home_shake_hint"
                android:textColor="@color/home_thumb"
                android:textSize="21sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_btn_draw"
                style="@style/Widget.LuckyShake.Button.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="@string/home_btn_draw" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
