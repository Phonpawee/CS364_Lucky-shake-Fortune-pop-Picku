<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">
        <TextView
            android:id="@+id/home_title_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_title_main"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.LuckyShake.Heading"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/home_label_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_label_set"
            android:gravity="center"
            android:labelFor="@id/home_spinner_set"
            app:layout_constraintTop_toBottomOf="@id/home_title_main"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <Spinner
            android:id="@+id/home_spinner_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            app:layout_constraintWidth_max="360dp"
            app:layout_constraintTop_toBottomOf="@id/home_label_set"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/home_label_filter_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_label_filter_type"
            android:labelFor="@id/home_spinner_type"
            app:layout_constraintTop_toBottomOf="@id/home_spinner_set"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <Spinner
            android:id="@+id/home_spinner_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/home_label_filter_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/home_switch_no_fried"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/home_label_no_fried"
            app:layout_constraintTop_toBottomOf="@id/home_spinner_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/home_switch_no_spicy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/home_label_no_spicy"
            app:layout_constraintTop_toBottomOf="@id/home_switch_no_fried"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_btn_clear_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="?attr/borderlessButtonStyle"
            android:text="@string/home_btn_clear_filters"
            app:layout_constraintTop_toBottomOf="@id/home_switch_no_spicy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/home_label_filter_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            app:layout_constraintTop_toBottomOf="@id/home_btn_clear_filters"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_image_tube"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/home_label_tube"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_tube"
            app:layout_constraintTop_toBottomOf="@id/home_label_filter_count"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_btn_draw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Widget.LuckyShake.Button.Primary"
            android:text="@string/home_btn_draw"
            app:layout_constraintTop_toBottomOf="@id/home_image_tube"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/reminder_permission_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reminder_btn_allow_notifications"
            app:layout_constraintTop_toBottomOf="@id/home_btn_draw"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
