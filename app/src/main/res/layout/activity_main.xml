<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">
        <TextView
            android:id="@+id/home_title_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/home_title_main"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.LuckyShake.Heading"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/home_label_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_label_set"
            android:gravity="center"
            android:labelFor="@id/home_spinner_set"
            app:layout_constraintTop_toBottomOf="@id/home_title_main"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <Spinner
            android:id="@+id/home_spinner_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            app:layout_constraintWidth_max="360dp"
            app:layout_constraintTop_toBottomOf="@id/home_label_set"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/home_label_filters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_label_filters"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/home_spinner_set"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_image_tube"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="68dp"
            android:contentDescription="@string/home_label_tube"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_tube"
            app:layout_constraintTop_toBottomOf="@id/home_label_filters"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_image_stick"
            android:layout_width="20dp"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_stick"
            app:layout_constraintTop_toTopOf="@id/home_image_tube"
            app:layout_constraintStart_toStartOf="@id/home_image_tube"
            app:layout_constraintEnd_toEndOf="@id/home_image_tube" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_btn_draw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Widget.LuckyShake.Button.Primary"
            android:text="@string/home_btn_draw"
            app:layout_constraintTop_toBottomOf="@id/home_image_tube"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
