<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LuckyShake.Home"
    tools:context=".ui.group.GroupProposalActivity">

    <ImageView
        style="@style/Widget.LuckyShake.TabPage.Sky" />

    <ScrollView
        android:id="@+id/group_proposal_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Widget.LuckyShake.TabBanner"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    android:id="@+id/group_proposal_title_turn"
                    style="@style/Widget.LuckyShake.TabBanner.Title"
                    tools:text="Person 1 of 2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tab_banner_art"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.cs364.luckyshake.ui.home.ShadowImageView
                    android:id="@+id/tab_banner_art"
                    style="@style/Widget.LuckyShake.TabBanner.Art"
                    app:srcCompat="@drawable/home_fox"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Single Main Card for Proposal Inputs -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/group_proposal_input_card"
                style="@style/Widget.LuckyShake.Card.Tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <!-- Instructions Subtitle -->
                    <TextView
                        android:id="@+id/group_proposal_instructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/group_proposal_msg_restaurant_hint"
                        android:textColor="@color/home_ink"
                        android:textSize="@dimen/text_body" />

                    <!-- Food Type Grid (Mode: FOOD_TYPE) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/group_proposal_food_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <!-- Food Type Error Message -->
                    <TextView
                        android:id="@+id/group_proposal_food_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/group_proposal_error_food_empty"
                        android:textColor="@color/home_accent"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- Restaurant Inputs Container (Mode: RESTAURANT_NAME) -->
                    <LinearLayout
                        android:id="@+id/group_proposal_restaurant_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Field 1 Label & Box -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:labelFor="@+id/group_proposal_edit_restaurant_1"
                            android:text="@string/group_proposal_hint_restaurant_1"
                            android:textColor="@color/home_ink" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/group_proposal_layout_restaurant_1"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            app:hintEnabled="false"
                            app:placeholderText="@string/group_proposal_hint_restaurant_example"
                            app:boxBackgroundColor="@color/home_field"
                            app:boxCornerRadiusTopStart="@dimen/corner_md"
                            app:boxCornerRadiusTopEnd="@dimen/corner_md"
                            app:boxCornerRadiusBottomStart="@dimen/corner_md"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_md"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/group_proposal_edit_restaurant_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLength="40"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Field 2 Label & Box -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:labelFor="@+id/group_proposal_edit_restaurant_2"
                            android:text="@string/group_proposal_hint_restaurant_2"
                            android:textColor="@color/home_ink" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/group_proposal_layout_restaurant_2"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            app:hintEnabled="false"
                            app:placeholderText="@string/group_proposal_hint_restaurant_example"
                            app:boxBackgroundColor="@color/home_field"
                            app:boxCornerRadiusTopStart="@dimen/corner_md"
                            app:boxCornerRadiusTopEnd="@dimen/corner_md"
                            app:boxCornerRadiusBottomStart="@dimen/corner_md"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_md"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/group_proposal_edit_restaurant_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLength="40"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Field 3 Label & Box -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:labelFor="@+id/group_proposal_edit_restaurant_3"
                            android:text="@string/group_proposal_hint_restaurant_3"
                            android:textColor="@color/home_ink" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/group_proposal_layout_restaurant_3"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            app:hintEnabled="false"
                            app:placeholderText="@string/group_proposal_hint_restaurant_example"
                            app:boxBackgroundColor="@color/home_field"
                            app:boxCornerRadiusTopStart="@dimen/corner_md"
                            app:boxCornerRadiusTopEnd="@dimen/corner_md"
                            app:boxCornerRadiusBottomStart="@dimen/corner_md"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_md"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/group_proposal_edit_restaurant_3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLength="40"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Group Tally & Winner Section (#37) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/group_tally_section"
                style="@style/Widget.LuckyShake.Card.Tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <!-- Tally List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/group_tally_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <!-- Hint Text -->
                    <TextView
                        android:id="@+id/group_tally_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/group_tally_hint"
                        android:textColor="@color/home_ink"
                        android:textSize="14sp" />

                    <!-- Draw Winner Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/group_tally_btn_draw"
                        style="@style/Widget.LuckyShake.Button.Menu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:minHeight="56dp"
                        android:text="@string/group_tally_btn_draw"
                        android:textStyle="bold"
                        app:cornerRadius="28dp" />

                    <!-- Winner Text Result -->
                    <TextView
                        android:id="@+id/group_tally_winner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="@color/home_accent"
                        android:background="@drawable/home_select_field"
                        android:padding="@dimen/spacing_md"
                        android:accessibilityLiveRegion="polite"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="ผู้ชนะ: KFC (×2)"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/group_tally_btn_home"
                style="@style/Widget.LuckyShake.Button.Menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/result_btn_home"
                android:visibility="gone"
                app:cornerRadius="28dp" />

            <!-- Button Pair at Bottom -->
            <LinearLayout
                android:id="@+id/group_proposal_button_pair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group_proposal_btn_skip"
                    style="@style/Widget.LuckyShake.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:minHeight="56dp"
                    android:text="@string/group_proposal_btn_skip"
                    android:textColor="@color/home_ink"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group_proposal_btn_confirm"
                    style="@style/Widget.LuckyShake.Button.Menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:minHeight="56dp"
                    android:text="@string/group_proposal_btn_confirm"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
