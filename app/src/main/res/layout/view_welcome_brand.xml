<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:paddingVertical="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/welcome_brand" android:textSize="@dimen/welcome_brand_size" android:textStyle="bold|italic"
        android:fontFamily="serif" android:gravity="center" android:lineSpacingExtra="-10sp"
        android:textColor="#FFF4D8" android:shadowColor="#B332140F"
        android:shadowDx="0" android:shadowDy="4" android:shadowRadius="10"
        android:accessibilityHeading="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:paddingHorizontal="18dp" android:paddingVertical="8dp"
        android:background="@drawable/welcome_caption" android:text="@string/welcome_tagline"
        android:textSize="16sp" android:textColor="#FFF4D8" android:gravity="center" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/welcome_start"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="220dp" android:minHeight="@dimen/welcome_start_height" android:layout_marginTop="16dp"
        android:paddingHorizontal="32dp" android:paddingTop="10dp" android:paddingBottom="14dp"
        android:text="@string/welcome_start" android:textSize="@dimen/welcome_start_size" android:textStyle="bold"
        android:fontFamily="sans-serif" android:textAllCaps="false" android:gravity="center"
        android:textColor="#FFF4D8" android:background="@drawable/welcome_start_button"
        app:backgroundTint="@null" android:backgroundTint="@null"
        android:shadowColor="#80300000" android:shadowDy="1" android:shadowRadius="2"
        android:stateListAnimator="@null" android:elevation="6dp" />
</LinearLayout>
