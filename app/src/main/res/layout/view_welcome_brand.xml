<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:paddingVertical="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/welcome_brand" android:textSize="68sp" android:textStyle="bold|italic"
        android:fontFamily="serif" android:gravity="center" android:lineSpacingExtra="-10sp"
        android:textColor="#FFF4D8" android:shadowColor="#B332140F"
        android:shadowDx="0" android:shadowDy="4" android:shadowRadius="10"
        android:accessibilityHeading="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:paddingHorizontal="18dp" android:paddingVertical="8dp"
        android:background="@drawable/welcome_caption" android:text="@string/welcome_tagline"
        android:textSize="16sp" android:textColor="#FFF4D8" android:gravity="center" />
    <com.google.android.material.button.MaterialButton android:id="@+id/welcome_start"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="220dp" android:minHeight="56dp" android:layout_marginTop="16dp"
        android:paddingHorizontal="32dp" android:paddingVertical="12dp"
        android:text="@string/welcome_start" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#FFF4D8" app:backgroundTint="#A52F23"
        app:cornerRadius="30dp" app:strokeColor="#F1C77E" app:strokeWidth="2dp"
        android:elevation="6dp" />
</LinearLayout>
