<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LuckyShake.Home">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/result_sky" />

    <ScrollView
        android:id="@+id/group_winner_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="20dp"
            android:paddingEnd="32dp"
            android:paddingBottom="20dp">

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="4" />

            <TextView
                android:id="@+id/group_winner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/result_title_background"
                android:elevation="4dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/group_winner_title"
                android:textColor="@color/home_thumb"
                android:textSize="25sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:clipChildren="false">

                <com.cs364.luckyshake.ui.home.ShadowImageView
                    android:id="@+id/group_winner_image_stick"
                    android:layout_width="33dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/home_stick" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_filter_card"
                android:elevation="9dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp">

                <TextView
                    android:id="@+id/group_winner_label_stick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/home_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="ไม้เซียมซีเลข 7" />

                <TextView
                    android:id="@+id/group_winner_label_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:textColor="@color/home_ink"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    tools:text="ปิ้งย่าง / หมูกระทะ" />

                <TextView
                    android:id="@+id/group_winner_label_proposers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/home_ink"
                    android:textSize="14sp"
                    tools:text="เสนอโดย คนที่ 1, คนที่ 3" />

                <TextView
                    android:id="@+id/group_winner_label_votes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/home_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="2 เสียง" />

                <TextView
                    android:id="@+id/group_winner_label_stars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/home_accent"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="★★★★" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/home_outline"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/group_winner_label_fortune"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/home_ink"
                    android:textSize="15sp"
                    tools:text="วันนี้อาจมีเรื่องเล็ก ๆ มาทำให้ยิ้ม ขอให้อร่อยกับ..." />

                <TextView
                    android:id="@+id/group_winner_msg_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/result_msg_disclaimer"
                    android:textColor="@color/home_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/home_filter_card"
                android:elevation="9dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group_winner_btn_new_round"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="6dp"
                    android:foreground="@drawable/button_depth_glaze"
                    android:minHeight="48dp"
                    android:text="@string/group_winner_btn_new_round"
                    android:textColor="@color/home_thumb"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/home_draw_tint"
                    app:cornerRadius="26dp"
                    app:strokeColor="@color/home_outline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group_winner_btn_home"
                    style="@style/Widget.LuckyShake.Button.Segment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/result_btn_home" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
