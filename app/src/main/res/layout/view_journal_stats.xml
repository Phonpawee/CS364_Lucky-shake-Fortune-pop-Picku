<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/journal_stats_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card 1: Most Drawn Dishes -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_stats_top"
            style="@style/Widget.LuckyShake.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/journal_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/journal_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/stats_title_top"
                    android:textColor="@color/journal_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/stats_top_dishes_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Accepted / Redrawn Ratio -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_stats_ratio"
            style="@style/Widget.LuckyShake.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/journal_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/journal_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/stats_title_ratio"
                    android:textColor="@color/journal_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/stats_progress_ratio"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progressDrawable="@drawable/journal_progress_red"
                    tools:progress="80" />

                <TextView
                    android:id="@+id/stats_label_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/journal_text_muted"
                    android:textSize="14sp"
                    tools:text="ยอมรับ 4 · ขอใหม่ 0 (100%)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Last 7 Days Bar Chart -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_stats_week"
            style="@style/Widget.LuckyShake.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/journal_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/journal_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/stats_title_week"
                    android:textColor="@color/journal_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 7 Equal Weight Columns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Day 0 (6 days ago) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_bar_count_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <View
                                android:id="@+id/stats_bar_view_0"
                                android:layout_width="24dp"
                                android:layout_height="3dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@color/journal_chart_bar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/stats_bar_day_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text_muted"
                            android:textSize="12sp"
                            tools:text="เสาร์" />
                    </LinearLayout>

                    <!-- Day 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_bar_count_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <View
                                android:id="@+id/stats_bar_view_1"
                                android:layout_width="24dp"
                                android:layout_height="3dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@color/journal_chart_bar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/stats_bar_day_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text_muted"
                            android:textSize="12sp"
                            tools:text="อาทิตย์" />
                    </LinearLayout>

                    <!-- Day 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_bar_count_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <View
                                android:id="@+id/stats_bar_view_2"
                                android:layout_width="24dp"
                                android:layout_height="3dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@color/journal_chart_bar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/stats_bar_day_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text_muted"
                            android:textSize="12sp"
                            tools:text="จันทร์" />
                    </LinearLayout>

                    <!-- Day 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_bar_count_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <View
                                android:id="@+id/stats_bar_view_3"
                                android:layout_width="24dp"
                                android:layout_height="3dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@color/journal_chart_bar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/stats_bar_day_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text_muted"
                            android:textSize="12sp"
                            tools:text="อังคาร" />
                    </LinearLayout>

                    <!-- Day 4 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_bar_count_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <View
                                android:id="@+id/stats_bar_view_4"
                                android:layout_width="24dp"
                                android:layout_height="3dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@color/journal_chart_bar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/stats_bar_day_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text_muted"
                            android:textSize="12sp"
                            tools:text="พุธ" />
                    </LinearLayout>

                    <!-- Day 5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_bar_count_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <View
                                android:id="@+id/stats_bar_view_5"
                                android:layout_width="24dp"
                                android:layout_height="30dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@color/journal_chart_bar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/stats_bar_day_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text_muted"
                            android:textSize="12sp"
                            tools:text="พฤหัส" />
                    </LinearLayout>

                    <!-- Day 6 (Today) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stats_bar_count_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="3" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp">

                            <View
                                android:id="@+id/stats_bar_view_6"
                                android:layout_width="24dp"
                                android:layout_height="90dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@color/journal_chart_bar" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/stats_bar_day_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/journal_text_muted"
                            android:textSize="12sp"
                            tools:text="ศุกร์" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
