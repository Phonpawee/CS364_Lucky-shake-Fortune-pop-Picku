<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LuckyShake.Home">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/home_sky" />

    <ScrollView
        android:id="@+id/menu_form_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:context=".ui.menu.MenuFormActivity">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginEnd="14dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.LuckyShake.Card.Tab">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">
                            <TextView
                                android:id="@+id/menu_form_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="5dp"
                                android:textSize="23sp"
                                android:textStyle="bold"
                                android:background="@drawable/result_title_background"
                                android:textColor="@color/home_thumb"
                                android:accessibilityHeading="true" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/menu_form_name_layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:hint="@string/menu_form_hint_name">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/menu_form_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionDone"
                                    android:inputType="textCapSentences"
                                    android:maxLength="60"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/menu_form_label_type"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/menu_form_type"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/menu_form_label_type"
                                android:minHeight="@dimen/button_min_height" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.LuckyShake.Card.Tab">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/menu_form_label_tags"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/menu_form_tag_spicy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/button_min_height"
                                android:text="@string/menu_label_tag_spicy" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/menu_form_tag_fried"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/button_min_height"
                                android:text="@string/menu_label_tag_fried" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/menu_form_tag_veggie"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/button_min_height"
                                android:text="@string/menu_label_tag_veggie" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:gravity="end"
                                android:orientation="horizontal">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/menu_form_cancel"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/spacing_sm"
                                    android:text="@string/common_btn_cancel" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/menu_form_save"
                                    style="@style/Widget.LuckyShake.Button.Primary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/common_btn_save" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
