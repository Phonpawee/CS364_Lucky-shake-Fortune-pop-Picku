<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LuckyShake.Home">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/home_sky" />

    <LinearLayout
        android:id="@+id/journal_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ui.journal.JournalActivity">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="14dp"
            android:clipToPadding="false">
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_md"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/journal_title_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/spacing_sm"
                        android:text="@string/journal_title_main"
                        android:textColor="@color/home_thumb"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:paddingVertical="5dp"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:background="@drawable/result_title_background"
                        android:accessibilityHeading="true" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/journal_toggle_group_tab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        app:cornerRadius="22dp"
                        app:selectionRequired="true"
                        app:singleSelection="true"
                        app:strokeColor="@color/journal_outline"
                        app:strokeWidth="1dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/journal_btn_tab_entries"
                            style="@style/Widget.LuckyShake.Button.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:minHeight="44dp"
                            android:text="@string/journal_tab_entries"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/journal_btn_tab_stats"
                            style="@style/Widget.LuckyShake.Button.Segment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:minHeight="44dp"
                            android:text="@string/journal_tab_stats"
                            android:textStyle="bold" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:id="@+id/journal_filter_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/journal_chip_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:checkedIconVisible="false"
                            app:selectionRequired="true"
                            app:singleLine="false"
                            app:singleSelection="true">
                            <com.google.android.material.chip.Chip
                                android:id="@+id/journal_chip_all"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/journal_btn_filter_all"
                                android:textColor="@color/journal_chip_text"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                app:checkedIconVisible="false"
                                app:chipBackgroundColor="@color/journal_chip_background"
                                app:chipCornerRadius="20dp"
                                app:chipEndPadding="12dp"
                                app:chipMinHeight="40dp"
                                app:chipStartPadding="12dp"
                                app:chipStrokeColor="@color/journal_outline"
                                app:chipStrokeWidth="1dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/journal_chip_accepted"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/journal_btn_filter_accepted"
                                android:textColor="@color/journal_chip_text"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                app:checkedIconVisible="false"
                                app:chipBackgroundColor="@color/journal_chip_background"
                                app:chipCornerRadius="20dp"
                                app:chipEndPadding="12dp"
                                app:chipMinHeight="40dp"
                                app:chipStartPadding="12dp"
                                app:chipStrokeColor="@color/journal_outline"
                                app:chipStrokeWidth="1dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/journal_chip_redrawn"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/journal_btn_filter_redrawn"
                                android:textColor="@color/journal_chip_text"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                app:checkedIconVisible="false"
                                app:chipBackgroundColor="@color/journal_chip_background"
                                app:chipCornerRadius="20dp"
                                app:chipEndPadding="12dp"
                                app:chipMinHeight="40dp"
                                app:chipStartPadding="12dp"
                                app:chipStrokeColor="@color/journal_outline"
                                app:chipStrokeWidth="1dp" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/journal_btn_clear_all"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/journal_btn_clear_all"
                            android:textColor="@color/journal_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/journal_card_entries"
                    style="@style/Widget.LuckyShake.Card.Tab"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/journal_recycler"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingVertical="@dimen/spacing_sm" />

                        <LinearLayout
                            android:id="@+id/journal_empty_group"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/journal_empty_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:textColor="@color/journal_text"
                                android:textSize="@dimen/text_body"
                                tools:text="ยังไม่มีประวัติ ลองเสี่ยงเซียมซีดูสิ" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <include
                    android:id="@+id/view_journal_stats"
                    layout="@layout/view_journal_stats"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
