<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LuckyShake.Home"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/home_sky" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/home_landscape_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="12dp">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:id="@+id/home_landscape_scroll">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/home_title_main"
                    style="@style/Widget.LuckyShake.TabBanner.Title"
                    android:layout_width="match_parent"
                    android:text="@string/home_title_main"
                    android:textSize="26sp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="5dp"
                    android:textStyle="bold"
                    android:background="@drawable/result_title_background"
                    android:textColor="@color/home_thumb"
                    android:accessibilityHeading="true"
                    android:layout_gravity="center_horizontal"
                    android:elevation="4dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="@string/home_shake_hint"
                    android:textColor="@color/home_title"
                    android:textSize="15sp"
                    android:layout_gravity="center_horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_filter_card"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:id="@+id/home_picker_row">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/home_label_set"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/home_spinner_set"
                                android:text="@string/home_label_set"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/home_spinner_set"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:minHeight="48dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="30dp"
                                android:background="@drawable/home_spinner_background"
                                android:popupBackground="@color/home_field" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/home_label_type"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/home_spinner_type"
                                android:text="@string/home_label_filter_type"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/home_spinner_type"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:minHeight="48dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="30dp"
                                android:background="@drawable/home_spinner_background"
                                android:popupBackground="@color/home_field" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/home_switch_no_fried"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/home_label_no_fried"
                        app:thumbTint="@color/home_thumb"
                        app:trackTint="@color/home_switch_track" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/home_switch_no_spicy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/home_label_no_spicy"
                        app:thumbTint="@color/home_thumb"
                        app:trackTint="@color/home_switch_track" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_outline"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/home_filter_footer">

                        <TextView
                            android:id="@+id/home_label_filter_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityLiveRegion="polite"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/home_btn_clear_filters"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/home_btn_clear_filters"
                            android:textColor="@color/home_accent" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="175dp"
                    android:layout_marginTop="0dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/home_sakura" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|top"
                        android:layout_marginEnd="14dp"
                        android:layout_marginTop="25dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/home_maple" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:layout_gravity="center_horizontal|top"
                        android:translationX="54dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/home_star" />

                    <com.cs364.luckyshake.ui.home.ShadowImageView
                        android:layout_width="109dp"
                        android:layout_height="125dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:translationX="59dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/home_fox" />

                    <com.cs364.luckyshake.ui.home.ShadowImageView
                        android:id="@+id/home_image_tube"
                        android:layout_width="102dp"
                        android:layout_height="168dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginEnd="42dp"
                        android:contentDescription="@string/home_label_tube"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/home_tube" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/home_image_stick"
                        android:layout_width="11dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="54dp"
                        android:layout_marginEnd="42dp"
                        android:importantForAccessibility="no"
                        android:visibility="invisible"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/home_stick" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_btn_draw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="52dp"
                    android:fontFamily="serif"
                    android:text="@string/home_btn_draw"
                    android:textColor="@color/home_thumb"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/home_draw_tint"
                    app:cornerRadius="30dp"
                    app:strokeColor="@color/home_outline"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reminder_permission_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:text="@string/reminder_btn_allow_notifications"
                    android:textColor="@color/home_ink"
                    app:backgroundTint="@color/home_paper"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/home_outline"
                    app:strokeWidth="1dp"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
