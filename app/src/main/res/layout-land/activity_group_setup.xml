<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LuckyShake.Home">
    <ImageView
        style="@style/Widget.LuckyShake.TabPage.Sky" />

    <ScrollView
        android:id="@+id/group_setup_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:context=".ui.group.GroupSetupActivity">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">
            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Widget.LuckyShake.TabBanner">
                <TextView
                    android:id="@+id/group_setup_title"
                    style="@style/Widget.LuckyShake.TabBanner.Title"
                    android:text="@string/group_setup_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tab_banner_art"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.cs364.luckyshake.ui.home.ShadowImageView
                    android:id="@+id/tab_banner_art"
                    style="@style/Widget.LuckyShake.TabBanner.Art"
                    app:srcCompat="@drawable/home_fox"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LuckyShake.Card.Tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:id="@+id/group_setup_instructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="@string/group_setup_msg_instructions"
                        android:textColor="@color/home_ink"
                        android:textSize="@dimen/text_body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="0.7"
                            android:layout_marginEnd="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_sm"
                                android:text="@string/group_setup_label_participants"
                                android:textColor="@color/home_ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_marginBottom="@dimen/spacing_md">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/group_setup_btn_decrement"
                                    style="@style/Widget.LuckyShake.Button.Stepper"
                                    android:layout_width="48dp"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/group_setup_desc_decrement"
                                    android:text="@string/group_setup_btn_decrement"
                                    android:textColor="@color/home_ink"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/group_setup_text_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_lg"
                                    android:layout_marginEnd="@dimen/spacing_lg"
                                    android:gravity="center"
                                    android:textColor="@color/home_ink"
                                    android:minWidth="44dp"
                                    android:textSize="29sp"
                                    android:textStyle="bold"
                                    tools:text="2" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/group_setup_btn_increment"
                                    style="@style/Widget.LuckyShake.Button.Stepper"
                                    android:layout_width="48dp"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/group_setup_desc_increment"
                                    android:text="@string/group_setup_btn_increment"
                                    android:textColor="@color/home_ink"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1.3">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_sm"
                                android:text="@string/group_setup_label_method"
                                android:textColor="@color/home_ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/group_setup_toggle_group_method"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/group_setup_btn_method_food_type"
                                    style="@style/Widget.LuckyShake.Button.Segment"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/group_setup_label_method_food_type" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/group_setup_btn_method_restaurant_name"
                                    style="@style/Widget.LuckyShake.Button.Segment"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/group_setup_label_method_restaurant_name" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <TextView
                                android:id="@+id/text_method_hint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textColor="@color/home_ink"
                                android:textSize="14sp"
                                tools:text="แต่ละคนเลือกกลุ่มอาหารที่อยากกิน 1 กลุ่ม..." />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/group_setup_btn_start"
                style="@style/Widget.LuckyShake.Button.Menu"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                app:cornerRadius="28dp"
                android:text="@string/group_setup_btn_start"
                android:layout_gravity="end" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
