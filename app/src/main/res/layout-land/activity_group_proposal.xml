<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/group_proposal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    tools:context=".ui.group.GroupProposalActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Single Main Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LuckyShake.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Person X of N Header -->
                <TextView
                    android:id="@+id/group_proposal_title_turn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/app_on_surface"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    tools:text="ถึงตาคนที่ 1 จาก 2" />

                <!-- Instructions Subtitle -->
                <TextView
                    android:id="@+id/group_proposal_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/group_proposal_msg_restaurant_hint"
                    android:textColor="@color/app_on_surface"
                    android:textSize="@dimen/text_body" />

                <!-- Field 1 Label & Box -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/group_proposal_hint_restaurant_1"
                    android:textColor="@color/app_on_surface" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/group_proposal_layout_restaurant_1"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:hintEnabled="false"
                    app:placeholderText="@string/group_proposal_hint_restaurant_example"
                    app:boxBackgroundColor="@color/app_background"
                    app:boxCornerRadiusTopStart="@dimen/corner_md"
                    app:boxCornerRadiusTopEnd="@dimen/corner_md"
                    app:boxCornerRadiusBottomStart="@dimen/corner_md"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_md"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/group_proposal_edit_restaurant_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="40"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Field 2 Label & Box -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/group_proposal_hint_restaurant_2"
                    android:textColor="@color/app_on_surface" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/group_proposal_layout_restaurant_2"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:hintEnabled="false"
                    app:placeholderText="@string/group_proposal_hint_restaurant_example"
                    app:boxBackgroundColor="@color/app_background"
                    app:boxCornerRadiusTopStart="@dimen/corner_md"
                    app:boxCornerRadiusTopEnd="@dimen/corner_md"
                    app:boxCornerRadiusBottomStart="@dimen/corner_md"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_md"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/group_proposal_edit_restaurant_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="40"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Field 3 Label & Box -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/group_proposal_hint_restaurant_3"
                    android:textColor="@color/app_on_surface" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/group_proposal_layout_restaurant_3"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:hintEnabled="false"
                    app:placeholderText="@string/group_proposal_hint_restaurant_example"
                    app:boxBackgroundColor="@color/app_background"
                    app:boxCornerRadiusTopStart="@dimen/corner_md"
                    app:boxCornerRadiusTopEnd="@dimen/corner_md"
                    app:boxCornerRadiusBottomStart="@dimen/corner_md"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_md"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/group_proposal_edit_restaurant_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="40"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Button Pair at Bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/group_proposal_btn_skip"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:minHeight="56dp"
                android:text="@string/group_proposal_btn_skip"
                android:textColor="@color/app_on_surface"
                android:textStyle="bold"
                app:backgroundTint="@color/app_surface"
                app:cornerRadius="28dp"
                app:strokeColor="@color/app_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/group_proposal_btn_confirm"
                style="@style/Widget.LuckyShake.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:minHeight="56dp"
                android:text="@string/group_proposal_btn_confirm"
                android:textStyle="bold"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
