<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:theme="@style/ThemeOverlay.LuckyShake.Home" android:clipToPadding="false">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/home_sky" />
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/home_landscape_content" android:clipToPadding="false" android:orientation="horizontal" android:baselineAligned="false" android:padding="24dp" app:layout_constraintWidth_max="1000dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:id="@+id/home_landscape_scroll">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/home_title_main" style="@style/Widget.LuckyShake.TabBanner.Title" android:layout_width="match_parent" android:text="@string/home_title_main" android:textSize="26sp" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:gravity="center" android:paddingHorizontal="16dp" android:paddingVertical="5dp" android:textStyle="bold" android:background="@drawable/result_title_background" android:textColor="@color/home_thumb" android:accessibilityHeading="true" android:layout_gravity="center_horizontal" android:elevation="4dp" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/home_filter_card" android:elevation="5dp" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/home_picker_row">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="10dp" android:orientation="vertical">
                                <TextView android:id="@+id/home_label_set" android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/home_spinner_set" android:text="@string/home_label_set" android:textStyle="bold" />
                                <Spinner android:id="@+id/home_spinner_set" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:paddingStart="10dp" android:paddingEnd="30dp" android:background="@drawable/home_spinner_background" android:popupBackground="@color/home_field" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/home_label_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/home_spinner_type" android:text="@string/home_label_filter_type" android:textStyle="bold" />
                                <Spinner android:id="@+id/home_spinner_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:paddingStart="10dp" android:paddingEnd="30dp" android:background="@drawable/home_spinner_background" android:popupBackground="@color/home_field" />
                            </LinearLayout>
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/home_switch_no_fried" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_label_no_fried" app:thumbTint="@color/home_thumb" app:trackTint="@color/home_switch_track" />
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/home_switch_no_spicy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_label_no_spicy" app:thumbTint="@color/home_thumb" app:trackTint="@color/home_switch_track" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/home_outline" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/home_filter_footer">
                            <TextView android:id="@+id/home_label_filter_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:accessibilityLiveRegion="polite" android:textStyle="bold" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/home_btn_clear_filters" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_btn_clear_filters" android:textColor="@color/home_accent" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="0dp" android:clipChildren="false" android:clipToPadding="false">
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="12dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_sakura" />
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="54dp" android:layout_height="54dp" android:layout_gravity="end|top" android:layout_marginEnd="21dp" android:layout_marginTop="38dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_maple" />
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center_horizontal|top" android:translationX="81dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_star" />
                        <com.cs364.luckyshake.ui.home.ShadowImageView android:layout_width="164dp" android:layout_height="188dp" android:layout_gravity="center_horizontal|bottom" android:translationX="88dp" android:importantForAccessibility="no" android:scaleType="fitCenter" app:srcCompat="@drawable/home_fox" />
                        <com.cs364.luckyshake.ui.home.ShadowImageView android:id="@+id/home_image_tube" android:layout_width="153dp" android:layout_height="252dp" android:layout_gravity="center_horizontal|bottom" android:layout_marginEnd="63dp" android:contentDescription="@string/home_label_tube" android:scaleType="fitCenter" app:srcCompat="@drawable/home_tube" />
                        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/home_image_stick" android:layout_width="16dp" android:layout_height="117dp" android:layout_gravity="center_horizontal|top" android:layout_marginTop="81dp" android:layout_marginEnd="63dp" android:importantForAccessibility="no" android:visibility="invisible" android:scaleType="fitCenter" app:srcCompat="@drawable/home_stick" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/result_title_background"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="@string/home_shake_hint"
                        android:textColor="@color/home_thumb"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_btn_draw"
                        style="@style/Widget.LuckyShake.Button.Segment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/home_btn_draw" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_permission_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:text="@string/reminder_btn_allow_notifications" android:textColor="@color/home_ink" app:backgroundTint="@color/home_paper" app:cornerRadius="24dp" app:strokeColor="@color/home_outline" app:strokeWidth="1dp" android:layout_gravity="center_horizontal" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>